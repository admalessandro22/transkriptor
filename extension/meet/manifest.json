{
  "manifest_version": 3,
  "key": "",
  "name": "Transkriptor Meet Bridge",
  "version": "2.0.0",
  "description": "Envia nomes dos participantes do Google Meet ao Transkriptor local.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "rtc.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icone-16.png",
    "32": "icons/icone-32.png",
    "48": "icons/icone-48.png",
    "128": "icons/icone-128.png"
  }
}
