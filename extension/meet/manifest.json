{
  "manifest_version": 3,
  "name": "Transkriptor Meet Bridge",
  "version": "1.0.0",
  "description": "Envia nomes dos participantes do Google Meet ao Transkriptor local.",
  "permissions": ["storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
